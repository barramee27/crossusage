# Tauri updater signing
TAURI_SIGNING_PRIVATE_KEY=/path/to/your.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS code signing
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarization
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# Vite / `tauri dev` only: set to 1 to save placeholder provider tokens instead of pasted values (optional).
# VITE_PROVIDER_ACCOUNT_DEV_MOCK=1

# Optional provider auth for local development
OLLAMA_SESSION_COOKIE=
OLLAMA_COOKIE=
OLLAMA_API_KEY=
